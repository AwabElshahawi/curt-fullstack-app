      "name": "Auth",
      "item": [
        {
          "name": "Register - valid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"awab\",\n  \"email\": \"awab@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Returns token', () => pm.expect(data.token).to.be.a('string'));",
                  "pm.test('No password in response', () => pm.expect(data.user.password).to.be.undefined);",
                  "if (data.token) pm.collectionVariables.set('token', data.token);",
                  "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email (expect 400/409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"awab2\",\n  \"email\": \"awab@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects duplicate email', () => pm.expect(pm.response.code).to.be.oneOf([400, 409]));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ]
        },
